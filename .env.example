APP_NAME="STETECH AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=stetech_ai
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# Encryption key used ONLY to encrypt broker credential payloads at rest,
# separate from APP_KEY so it can be rotated independently.
BROKER_CREDENTIAL_CIPHER_KEY=

# --- Broker / execution integration -----------------------------------
# STETECH AI ships with NO live execution driver enabled by default.
# Wire a real adapter here only after a strategy has cleared paper
# trading and your own risk/compliance review. See:
# app/Services/Execution/ExecutionEngine.php
BROKER_EXECUTION_MODE=paper   # paper | disabled  (never default to "live")
MT5_BRIDGE_URL=
MT5_BRIDGE_TOKEN=

# The single kill switch for real-money order placement. ExecutionEngine
# checks this directly (not just via middleware) -- see its docblock.
# Do not set this to true outside a deploy you've deliberately reviewed.
LIVE_TRADING_ENABLED=false

MAIL_MAILER=log

# STETECH AI SERVICE (configure via encrypted Admin Settings in production)
AI_SERVICE_URL=
AI_SERVICE_TOKEN=

# REAL MARKET DATA / BROKER PROVIDERS
# Market-data credentials are configured in Super Admin > Settings and stored encrypted in PostgreSQL.
# Do not put provider keys here in production.
TWELVE_DATA_API_KEY=
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_API_URL=
# Set to api-fxtrade.oanda.com only after production credentials and compliance approval.

# Real broker integrations
BROKER_EXECUTION_MODE=paper
CTRADER_GATEWAY_URL=
# Each MT5 connector has its own URL/token; never expose these to browser clients.

# Production operations
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_HOST=redis
REDIS_PORT=6379
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
AI_SERVICE_URL=http://ai-service:8001
APP_ENV=production
APP_DEBUG=false
LOG_CHANNEL=stack

# Production internal security
AI_INTERNAL_CALLBACK_SECRET=
LIVE_TRADING_ENABLED=false

# Production safety gate
LIVE_TRADING_ENABLED=false
